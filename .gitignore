# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Local secrets (Apple notarization creds etc.) — never commit. Template
# lives in .env.example.
.env

# Virtual environments
.venv

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.pyright/
.coverage
htmlcov/
coverage.xml

# Editor / OS
.DS_Store
.idea/
.vscode/

# Project data — keep the dirs (.gitkeep) but never commit user audio or convert artifacts
input/*
output/*
!input/.gitkeep
!output/.gitkeep

# Playwright MCP scratch
.playwright-mcp/

# Claude Code project state
.claude/

# Ad-hoc debug logs
*.log

# One catch-all scratch dir for local debug artefacts (playwright
# screenshots, ad-hoc logs, throwaway transcripts, etc). Keep noise out
# of the repo and out of every other gitignore rule. The legacy
# `screenshots/` name is grandfathered for older scripts that still
# expect it.
scratch/
screenshots/
# Exception: the README + docs reference real screenshots committed
# under docs/screenshots/, so don't sweep that path under the
# top-level `screenshots/` catch-all above.
!docs/screenshots/

# mkdocs build output
site/

# Desktop wrapper build artifacts
desktop/tauri/src-tauri/target/
desktop/tauri/src-tauri/gen/
desktop/electron/node_modules/
desktop/electron/dist/
desktop/electron/bun.lock

# Generated bundle so `maneki ui` can serve the SPA from an installed
# wheel. `scripts/copy_ui_static.py` mirrors `desktop/react/` into
# here; the canonical source lives in `desktop/react/`.
src/maneki/_ui_static/
