{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maneki",
  "version": "0.15.3",
  "identifier": "com.winterop.maneki",
  "build": {
    "frontendDist": "../../react/dist",
    "beforeBuildCommand": "cd ../react && bun install --frozen-lockfile && bun run build",
    "beforeDevCommand": "cd ../react && bun install --frozen-lockfile && bun run dev",
    "devUrl": "http://localhost:1421"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Maneki",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Maneki desktop client",
    "longDescription": "Native desktop wrapper around the Maneki web UI. Connects to a maneki serve instance over LAN or Tailscale and plays your library.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
