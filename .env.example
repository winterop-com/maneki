# Local build secrets for desktop NOTARIZATION. Copy to `.env` (which is
# gitignored) and fill in. Signing itself needs nothing here — the Tauri
# and Electron builds auto-discover the Developer ID from your login
# keychain. These are only for the extra notarization step.
#
# Format is `KEY=value` with NO surrounding quotes (the Makefile reads this
# via `include`, i.e. make syntax, not shell). None of the values below
# contain spaces, so unquoted is fine.
#
# See SIGNING.md for where each value comes from.

# Your Apple ID email.
APPLE_ID=you@example.com

# An app-specific password (appleid.apple.com -> Sign-In and Security ->
# App-Specific Passwords), NOT your real Apple ID password. Tauri reads
# APPLE_PASSWORD; electron-builder reads APPLE_APP_SPECIFIC_PASSWORD — set
# both to the same value so both wrappers notarize.
APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Your 10-character Team ID.
APPLE_TEAM_ID=XXXXXXXXXX

# Optional: pin the signing identity instead of auto-discovering it from
# the keychain. Usually leave this unset.
# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (XXXXXXXXXX)
